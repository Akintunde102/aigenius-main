# Frontend environment (copy to .env.local)

# Preferred (AIGenius)
NEXT_PUBLIC_AIGENIUS_API_ROOT_URL=http://localhost:8000

# Legacy alias (still supported)
NEXT_PUBLIC_NOBOX_API_ROOT_URL=http://localhost:8000

# Optional fallback
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# PRODUCT FEATURE FLAGS (opt-in — unset/false = hidden)
# =============================================================================
# NEXT_PUBLIC_ENABLE_VOICE_DICTATION=true
# NEXT_PUBLIC_ENABLE_AUDIO_CONVERSATION=true
# NEXT_PUBLIC_ENABLE_INTEGRATIONS=true
# NEXT_PUBLIC_ENABLE_WORKFLOWS=true
#
# Integrations (Gmail/LinkedIn) also require backend ENABLE_INTEGRATIONS=true.
#
# =============================================================================
# ANALYTICS (PostHog — opt-in)
# =============================================================================
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# When analytics is enabled, users see a consent banner on public pages before PostHog loads.
# Accepting also enables PostHog session replay (chat areas masked in replay).
