{
  "name": "aigenius-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AIGenius Electron shell (Linux, macOS, Windows)",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.4",
    "word-extractor": "^1.0.4"
  },
  "author": "AIGenius",
  "homepage": "https://aigenius.chat",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "exit 0",
    "rebuild:better-sqlite3": "electron-rebuild -v 43.4.1 -f -m ../desktop-server -o better-sqlite3",
    "test": "cross-env NODE_ENV=test jest --config jest.config.cjs",
    "test:tools:scenarios": "cross-env NODE_ENV=test jest --config jest.config.cjs --testPathPattern=local-desktop-tools\\.scenarios",
    "test:tools:all": "cross-env NODE_ENV=test jest --config jest.config.cjs --testPathPattern=\"local-desktop-tools|local-tool-executor|tool-formatter|read-file\"",
    "compile": "npm run sync-brand-icon && node scripts/compile-tsc.cjs",
    "ensure:server-deps": "node scripts/ensure-server-deps.cjs",
    "build:server": "npm run ensure:server-deps && cd ../desktop-server && npm run build",
    "build:desktop:ui": "node scripts/build-desktop-ui.cjs",
    "sync-brand-icon": "node scripts/sync-brand-icon.cjs",
    "prepare:resources": "node scripts/prepare-desktop-resources.cjs",
    "sync:package-resources": "node scripts/sync-package-extra-resources.cjs",
    "install:server-deps": "node scripts/install-server-deps-for-platform.cjs",
    "install:server-deps:win32": "node scripts/install-server-deps-for-platform.cjs win32 x64",
    "install:python-venv": "node scripts/prepare-python-venv.cjs",
    "prepackage": "node scripts/ensure-electron-dist.cjs && npm run compile && npm run build:server && npm run build:desktop:ui && npm run install:server-deps && npm run install:python-venv && npm run prepare:resources && npm run sync:package-resources",
    "prepackage:mac": "npm run prepackage",
    "prepackage:win": "npm run compile && npm run install:server-deps:win32 && npm run build:server && npm run build:desktop:ui && cross-env AIGENIUS_PACKAGE_PLATFORM=win32 AIGENIUS_PACKAGE_ARCH=x64 npm run install:python-venv && cross-env AIGENIUS_PACKAGE_PLATFORM=win32 AIGENIUS_PACKAGE_ARCH=x64 npm run prepare:resources && cross-env AIGENIUS_PACKAGE_PLATFORM=win32 AIGENIUS_PACKAGE_ARCH=x64 npm run sync:package-resources",
    "package": "electron-builder --linux deb flatpak",
    "package:deb": "electron-builder --linux deb",
    "package:deb:full": "npm run prepackage && electron-builder --linux deb",
    "package:flatpak": "electron-builder --linux flatpak",
    "package:mac": "electron-builder --mac -c.electronDist=../node_modules/electron/dist",
    "package:mac:dir": "electron-builder --mac dir -c.electronDist=../node_modules/electron/dist",
    "package:mac:full": "npm run prepackage:mac && electron-builder --mac -c.electronDist=../node_modules/electron/dist",
    "package:win": "electron-builder --win --x64",
    "package:win:dir": "electron-builder --win dir",
    "package:win:full": "npm run prepackage:win && electron-builder --win --x64",
    "dev:frontend": "cd ../frontend && npm run dev",
    "predev:electron:only": "node ../../scripts/ensure-frontend-ready.cjs",
    "dev:electron:only": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron .",
    "dev:electron": "npm run compile && npm run dev:electron:only",
    "dev:electron:debug": "npm run compile && cross-env ELECTRON_DISABLE_SANDBOX=1 AIGENIUS_DESKTOP_DEVTOOLS=1 electron .",
    "dev:quick": "npm run compile && npm run dev:electron:only",
    "dev:tilt": "node scripts/dev-tilt.cjs",
    "profile:cold-start": "node scripts/profile-cold-start.cjs",
    "profile:cold-start:tilt": "node scripts/profile-cold-start.cjs --external-mini-server",
    "profile:ipc": "node scripts/profile-ipc-benchmark.cjs",
    "profile:ipc:tilt": "node scripts/profile-ipc-benchmark.cjs --external-mini-server",
    "download-models": "node scripts/download-search-models.cjs",
    "dev": "npm run rebuild:better-sqlite3 && npm run build:server && npm run compile && npm run dev:electron:only"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/sharp": "^0.31.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "node-abi": "^4.33.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "chat.aigenius.desktop",
    "productName": "AIGenius",
    "electronVersion": "43.4.1",
    "directories": {
      "output": "release"
    },
    "icon": "build/aigenius_icon_final.png",
    "files": [
      "dist/**/*",
      "package.json",
      "build/aigenius_icon_final.png"
    ],
    "asarUnpack": [
      "dist/local-index/**",
      "dist/search/**",
      "dist/models/**",
      "node_modules/better-sqlite3/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "dist-resources/desktop-server",
        "to": "desktop-server"
      },
      {
        "from": "resources",
        "to": "aigenius-desktop-ui"
      },
      {
        "from": "dist-resources/desktop-ui",
        "to": "desktop-ui"
      },
      {
        "from": "dist-resources/desktop-ui-server",
        "to": "desktop-ui-server"
      },
      {
        "from": "dist-resources/python-venv",
        "to": "python-venv"
      },
      {
        "from": "dist-resources/package-runtime.json",
        "to": "package-runtime.json"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "flatpak"
      ],
      "category": "Office",
      "maintainer": "AIGenius",
      "synopsis": "AIGenius desktop client"
    },
    "deb": {
      "afterInstall": "scripts/linux/deb-after-install.sh"
    },
    "flatpak": {
      "runtimeVersion": "24.08",
      "baseVersion": "24.08",
      "finishArgs": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=dri"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AIGenius uses the microphone for voice dictation and conversation."
      }
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
