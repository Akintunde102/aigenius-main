# Copy to package.env before `npm run package:mac:full`.
# The mini-server proxies gateway traffic to this URL; the UI also uses it for
# direct API calls and WebSocket connections when running in the desktop shell.
#
# Production (Railway):
AIGENIUS_UPSTREAM_API_URL=https://aigenius-api.noboxlabs.xyz
#
# Local Tilt (uncomment for local backend):
# AIGENIUS_UPSTREAM_API_URL=http://localhost:28000
#
# Wallet checkout (baked into the desktop UI at package time — copy from client/.env.local):
# NEXT_PUBLIC_WALLET_PAYMENT_PROVIDER=payaza
# NEXT_PUBLIC_PAYAZA_PUBLIC_KEY=your-payaza-public-merchant-key
# NEXT_PUBLIC_PAYAZA_CHECKOUT_BUSINESS_NAME=Aigenius
# NEXT_PUBLIC_PAYSTACK_KEY=pk_live_your-paystack-public-key
#
# Payment return URL host (system browser redirects here after Payaza/Paystack):
# AIGENIUS_APP_ORIGIN=https://aigenius.noboxlabs.xyz
